{
  "name": "@clutter/editor",
  "version": "0.0.0",
  "private": true,
  "description": "Block-first editing engine for Clutter - Lexical-based editor with custom block architecture",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./types/index.ts",
      "import": "./types/index.ts"
    },
    "./engine": {
      "types": "./engine/index.ts",
      "import": "./engine/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.5",
    "@vitest/ui": "^4.0.17",
    "eslint": "^8.57.0",
    "happy-dom": "^20.3.3",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@clutter/ui": "*",
    "@lexical/code": "^0.39.0",
    "@lexical/history": "^0.39.0",
    "@lexical/link": "^0.39.0",
    "@lexical/list": "^0.39.0",
    "@lexical/markdown": "^0.39.0",
    "@lexical/plain-text": "^0.39.0",
    "@lexical/react": "^0.39.0",
    "@lexical/rich-text": "^0.39.0",
    "@lexical/selection": "^0.39.0",
    "immer": "^10.2.0",
    "lexical": "^0.39.0",
    "nanoid": "^3.3.11",
    "zustand": "^4.5.7"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
