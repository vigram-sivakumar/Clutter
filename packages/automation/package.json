{
  "name": "@clutter/automation",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Real-Tauri UI automation for Clutter — external consumer of apps/app, never a dependency of it.",
  "scripts": {
    "build:app": "cargo build --features automation --manifest-path ../../apps/app/src-tauri/Cargo.toml",
    "poc": "wdio run wdio.conf.ts"
  },
  "devDependencies": {
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-service": "^1.3.0",
    "typescript": "^5.6.3"
  }
}
