{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "the same fs capability Clutter's main window has",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-home-write-recursive",
    "fs:allow-mkdir",
    "fs:allow-home-read-recursive",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-write-file",
    { "identifier": "fs:scope", "allow": ["$HOME/**"] }
  ]
}
