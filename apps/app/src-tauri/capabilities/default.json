{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-exists",
    "fs:allow-stat",
    "allow-frontend-ready",
    "allow-frontend-failed",
    "allow-set-dock-badge",
    "allow-set-copy-page-link-enabled",
    "allow-atomic-write-file",
    "allow-atomic-inspect-write",
    "allow-atomic-confirm-durability",
    "allow-check-space-filesystem",
    "allow-initialize-space",
    "allow-export-pick-destination",
    "allow-export-copy-file",
    "allow-export-write-file",
    "allow-move-file-no-clobber",
    "allow-copy-file-no-clobber",
    "allow-write-file-no-clobber",
    "allow-parse-cache-read",
    "allow-parse-cache-write",
    "allow-parse-cache-remove",
    "allow-recovery-write",
    "allow-recovery-remove",
    "allow-create-directory",
    "allow-delete-path",
    "allow-trash-path",
    "allow-canonical-space-path",
    "allow-sandbox-info",
    "allow-restore-space-access",
    "allow-remember-space-access",
    "allow-forget-space-access",
    "allow-documents-access",
    "allow-request-documents-access",
    "allow-create-space-folder",
    "allow-ensure-space-access",
    "allow-rename-space-folder",
    "allow-check-rename-parent-access",
    "allow-request-rename-parent-access",
    "allow-allow-vault-asset-scope",
    "allow-start-vault-watcher",
    "allow-stop-vault-watcher",
    "dialog:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    {
      "identifier": "fs:scope",
      "allow": ["$HOME", "$HOME/**"]
    }
  ]
}
