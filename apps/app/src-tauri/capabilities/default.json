{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-home-write-recursive",
    "fs:allow-mkdir",
    "fs:allow-home-read-recursive",
    "fs:allow-exists",
    "fs:allow-rename",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/**"]
    }
  ]
}
