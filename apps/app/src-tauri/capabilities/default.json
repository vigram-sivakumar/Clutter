{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "fs:allow-home-write-recursive",
    "fs:allow-mkdir",
    "fs:allow-home-read-recursive",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-write-file",
    "allow-frontend-ready",
    "allow-frontend-failed",
    "allow-set-copy-page-link-enabled",
    "allow-atomic-write-file",
    "allow-atomic-inspect-write",
    "allow-atomic-confirm-durability",
    "allow-move-file-no-clobber",
    "allow-parse-cache-read",
    "allow-parse-cache-write",
    "allow-parse-cache-remove",
    "allow-canonical-space-path",
    "allow-create-space-folder",
    "allow-ensure-space-access",
    "allow-rename-space-folder",
    "allow-allow-vault-asset-scope",
    "allow-start-vault-watcher",
    "allow-stop-vault-watcher",
    "dialog:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/**"]
    }
  ]
}
