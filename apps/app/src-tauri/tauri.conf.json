{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Clutter",
  "version": "0.1.0",
  "identifier": "com.clutter.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Clutter",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 32
        },
        "width": 1020,
        "height": 920,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' 'unsafe-inline' 'unsafe-eval' ipc: http://ipc.localhost http://asset.localhost",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173 https://api.unsplash.com",
        "style-src": "'self' 'unsafe-inline'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
