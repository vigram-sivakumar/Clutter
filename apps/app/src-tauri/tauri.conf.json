{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Clutter",
  "version": "../package.json",
  "identifier": "com.vigram.clutter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run check:version && npm run check:atomic && npm run check:privacy && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Clutter",
        "dragDropEnabled": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 32
        },
        "width": 1020,
        "height": 920,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost http://asset.localhost",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://unsplash-proxy.clutterapp.workers.dev asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self' 'unsafe-inline' 'unsafe-eval' ipc: http://ipc.localhost http://asset.localhost",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173 http://localhost:1421 ws://localhost:1421 https://unsplash-proxy.clutterapp.workers.dev asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "http": {
      "scopeRedirects": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Clutter.icon"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Productivity",
    "copyright": "© 2026 Vigram Sivakumar",
    "macOS": {
      "bundleVersion": "1",
      "minimumSystemVersion": "13.3",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-",
      "files": {
        "Resources/PrivacyInfo.xcprivacy": "PrivacyInfo.xcprivacy",
        "Resources/Licenses/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
        "Resources/Licenses/Inter-OFL.txt": "../src/assets/fonts/inter/OFL.txt",
        "Resources/Licenses/EB-Garamond-OFL.txt": "../src/assets/fonts/eb-garamond/OFL.txt",
        "Resources/Licenses/Hanken-Grotesk-OFL.txt": "../src/assets/fonts/hanken-grotesk/OFL.txt",
        "Resources/Licenses/PDF.js-LICENSE.txt": "../../../node_modules/pdfjs-dist/LICENSE"
      }
    }
  }
}
