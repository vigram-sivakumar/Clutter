{
  "name": "@clutter/app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Clutter 2.0 - Core editor implementation with segmented architecture",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "automation:build": "cargo build --features automation --manifest-path src-tauri/Cargo.toml",
    "automation:poc": "wdio run devtools/automation/wdio.conf.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-service": "^1.3.0",
    "jsdom": "^29.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.0.17"
  }
}
