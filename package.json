{
  "name": "clutter-structured",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node apps/desktop/run.mjs",
    "desktop": "node apps/desktop/run.mjs",
    "desktop:reopen": "node apps/desktop/run.mjs --reopen",
    "desktop:check": "node apps/desktop/run.mjs --check",
    "test": "node --test packages/desktop-runtime/test/*.test.mjs",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p packages/desktop-runtime/tsconfig.json",
    "check:boundaries": "node tools/check-boundaries.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "25.9.4",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1"
  },
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=9.0.0"
  }
}
