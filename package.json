{
  "name": "clutter-notes",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/app",
    "dev:web": "npm run dev:web --workspace=apps/app",
    "tauri": "npm run tauri --workspace=apps/app --",
    "desktop": "npm run desktop --workspace=apps/app",
    "dev:sandbox": "npm run dev:sandbox --workspace=apps/app",
    "build:appstore": "npm run build:appstore --workspace=apps/app",
    "build:share": "npm run build:share --workspace=apps/app",
    "verify:bundle": "npm run verify:bundle --workspace=apps/app --",
    "test": "npm test --workspace=apps/app",
    "test:run": "npm test --workspace=apps/app -- --run",
    "automation:build": "npm run build:app --workspace=packages/automation",
    "automation:poc": "npm run poc --workspace=packages/automation",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/dist apps/*/coverage packages/*/node_modules",
    "release:direct": "npm run release:direct --workspace=apps/app --",
    "release:appstore": "npm run release:appstore --workspace=apps/app --",
    "check:release": "npm run check:release --workspace=apps/app",
    "check:appstore": "npm run check:appstore --workspace=apps/app"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.9.0",
  "overrides": {
    "@wdio/config": {
      "glob": "14.0.2"
    },
    "@wdio/tauri-service": {
      "webdriverio": "9.32.0"
    },
    "@wdio/utils": {
      "@puppeteer/browsers": "3.0.2"
    },
    "mocha": {
      "serialize-javascript": "7.1.3"
    },
    "readdir-glob@^3": {
      "minimatch": "11.0.1"
    }
  }
}
