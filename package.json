{
  "name": "clutter-notes",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/app",
    "dev:web": "npm run dev:web --workspace=apps/app",
    "test": "npm test --workspace=apps/app",
    "test:run": "npm test --workspace=apps/app -- --run",
    "automation:build": "npm run build:app --workspace=packages/automation",
    "automation:poc": "npm run poc --workspace=packages/automation",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/dist apps/*/coverage packages/*/node_modules"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.9.0"
}
